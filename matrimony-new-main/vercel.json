{
  "buildCommand": "cd MATRIMONY-main && npm install && npx vite build",
  "outputDirectory": "MATRIMONY-main/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://matrimony-production-4b00.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
