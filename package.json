{
  "name": "matrimony-workspace",
  "private": true,
  "scripts": {
    "dev": "npm --prefix matrimony-new-main/MATRIMONY-main run dev",
    "start": "npm --prefix matrimony-new-main/MATRIMONY-main run dev",
    "build": "npm --prefix matrimony-new-main/MATRIMONY-main install && npm --prefix matrimony-new-main/MATRIMONY-main run build",
    "postinstall": "npm --prefix matrimony-new-main/MATRIMONY-main install",
    "lint": "npm --prefix matrimony-new-main/MATRIMONY-main run lint",
    "typecheck": "npm --prefix matrimony-new-main/MATRIMONY-main run lint",
    "install:all": "npm --prefix matrimony-new-main/MATRIMONY-main install"
  }
}
