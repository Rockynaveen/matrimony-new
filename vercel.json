{
  "buildCommand": "cd MATRIMONY-main && npm run build",
  "outputDirectory": "MATRIMONY-main/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://matrimony-production-e116.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/MATRIMONY-main/index.html"
    }
  ]
}
